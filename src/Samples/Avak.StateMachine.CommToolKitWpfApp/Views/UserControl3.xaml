<UserControl x:Class="Avak.StateMachine.CommToolKitWpfApp.Views.UserControl3"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Avak.StateMachine.CommToolKitWpfApp.Views"
             xmlns:localVms="clr-namespace:Avak.StateMachine.CommToolKitWpfApp.ViewModels"
             d:DataContext="{d:DesignInstance Type=localVms:UserControl3ViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Label 
        Name="View1" 
        VerticalAlignment="Top" HorizontalAlignment="Center"
        Content="{Binding Title}" 
        Height="40" 
        Canvas.Left="10" Canvas.Top="10" 
        FontSize="14" FontFamily="Georgia" 
        FontWeight="Bold"/>
    </Grid>
</UserControl>
