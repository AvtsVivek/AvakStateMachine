<?xml version="1.0" encoding="utf-8"?>
<StateMachine initialState="Idle">
  <States>
    <State name="Idle">
      <Transitions>
        <Transition trigger="Start" source="Console" to="Running"
                    guard="ReadyToStart" onEntered="RecordStarted" />
      </Transitions>
    </State>
    <State name="Running" />
  </States>
</StateMachine>
