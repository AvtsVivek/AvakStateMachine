<Window x:Class="Avak.StateMachine.Sample.CommToolKitWpfApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Avak.StateMachine.Sample.CommToolKitWpfApp"
        xmlns:localViews="clr-namespace:Avak.StateMachine.Sample.CommToolKitWpfApp.Views"
        xmlns:localViewModels="clr-namespace:Avak.StateMachine.Sample.CommToolKitWpfApp.ViewModels"
        d:DataContext="{d:DesignInstance Type=localViewModels:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ContentControl Grid.Row="0" Content="{Binding CurrentPageViewModel}" />
        <TextBlock HorizontalAlignment="Center" Grid.Row="1" Text="{Binding Message}" />
        <Border Grid.Row="2">
            <ItemsControl x:Name="ItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <Button Content="Go to View Bb" Command="{Binding ClickCommand}" CommandParameter="EnterBbFromAa" Width="90" Height="30" Margin="0,10" />
                <Button Content="Go to View Cc" Command="{Binding ClickCommand}" CommandParameter="EnterCcFromBb" Width="90" Height="30" />
                <Button Content="Go to View Aa" Command="{Binding ClickCommand}" CommandParameter="EnterAaFromCc" Width="90" Height="30" />
            </ItemsControl>
        </Border>
    </Grid>
</Window>
