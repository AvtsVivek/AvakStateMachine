<?xml version="1.0" encoding="utf-8" ?>
<AvakStates Namespace="Avak.StateMachine.Sample.WpfViewChanged.StateManager.States">
	<Triggers>
		<Trigger Name="EnterBbFromAa" Source="Event"/>
		<Trigger Name="EnterCcFromBb" Source="Event"/>
		<Trigger Name="EnterDdFromCc" Source="Event"/>
		<Trigger Name="EnterAaFromDd" Source="Event"/>
	</Triggers>
	<States Initial="Aa"  >
		<State Name="Aa" >
			<Transition Trigger="EnterBbFromAa" Target="Bb"/>
		</State>
		<State Name="Bb">
			<Transition Trigger="EnterCcFromBb" Target="Cc"/>
		</State>
		<State Name="Cc">
			<Transition Trigger="EnterDdFromCc" Target="Dd"/>
		</State>
		<State Name="Dd">
			<Transition Trigger="EnterAaFromDd" Target="Aa"/>
		</State>
	</States>
</AvakStates>

